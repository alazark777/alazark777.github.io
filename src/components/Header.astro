---
import { site } from '../site.config';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/articles/', label: 'Articles' },
  { href: '/about/', label: 'About' },
] as const;

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

function withBase(path: string): string {
  if (path === '/') return base;
  return `${base.replace(/\/$/, '')}${path}`;
}

function isActive(href: string): boolean {
  const normalized = pathname.replace(/\/$/, '') || '/';
  if (href === '/') return normalized === '' || normalized === '/';
  return normalized.startsWith(href.replace(/\/$/, ''));
}
---

<header class="border-b border-border bg-surface-raised/90 backdrop-blur-sm">
  <div class="container-page flex flex-wrap items-center justify-between gap-4 py-4">
    <a href={withBase('/')} class="no-underline hover:no-underline">
      <span class="text-sm font-semibold tracking-tight text-ink">{site.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="flex flex-wrap items-center gap-1 sm:gap-2">
        {nav.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              class:list={[
                'rounded-md px-2.5 py-1.5 text-sm no-underline hover:no-underline',
                isActive(item.href)
                  ? 'bg-accent-soft font-medium text-accent'
                  : 'text-ink-muted hover:bg-placeholder hover:text-ink',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3 text-sm">
      {site.github && (
        <a href={site.github} class="text-ink-muted no-underline hover:text-accent hover:underline" rel="noopener noreferrer" target="_blank">
          GitHub
        </a>
      )}
      {site.linkedin && (
        <a href={site.linkedin} class="text-ink-muted no-underline hover:text-accent hover:underline" rel="noopener noreferrer" target="_blank">
          LinkedIn
        </a>
      )}
      {site.email && (
        <a href={`mailto:${site.email}`} class="text-ink-muted no-underline hover:text-accent hover:underline">
          Email
        </a>
      )}
      {site.showThemeToggle && (
        <button
          id="theme-toggle"
          type="button"
          class="rounded-md border border-border bg-surface-raised px-2.5 py-1.5 text-xs font-medium text-ink-muted transition-colors hover:border-border-strong hover:text-ink"
          aria-label="Switch to dark theme"
          aria-pressed="false"
        >
          <span aria-hidden="true">◐</span>
          <span class="sr-only">Dark theme</span>
        </button>
      )}
    </div>
  </div>
</header>

{site.showThemeToggle && (
  <script>
    const themeToggle = document.getElementById('theme-toggle');

    function updateThemeToggle() {
      const isDark = document.documentElement.dataset.theme === 'dark';
      if (!themeToggle) return;
      themeToggle.setAttribute('aria-pressed', String(isDark));
      themeToggle.setAttribute(
        'aria-label',
        isDark ? 'Switch to light theme' : 'Switch to dark theme',
      );
      themeToggle.innerHTML = isDark
        ? '<span aria-hidden="true">☼</span><span class="sr-only">Light theme</span>'
        : '<span aria-hidden="true">◐</span><span class="sr-only">Dark theme</span>';
    }

    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      document.documentElement.dataset.theme = isDark ? 'light' : 'dark';
      localStorage.setItem('portfolio-theme', isDark ? 'light' : 'dark');
      updateThemeToggle();
      window.dispatchEvent(new CustomEvent('portfolio-theme-change'));
    });

    updateThemeToggle();
  </script>
)}
