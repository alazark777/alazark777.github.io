---
import { site } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border">
  <div class="container-page flex flex-col gap-3 py-8 text-sm text-ink-subtle sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {year} {site.name}. Built as a static site on GitHub Pages.
    </p>
    <p class="text-ink-subtle">
      {site.headline}
    </p>
  </div>
</footer>
