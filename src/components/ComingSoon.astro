---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Coming soon',
  description = 'Details will appear here when available.',
} = Astro.props;
---

<div class="rounded-lg border border-dashed border-border-strong bg-placeholder/70 p-6">
  <p class="text-xs font-medium uppercase tracking-wide text-ink-subtle">Placeholder</p>
  <h3 class="mt-2 text-lg font-semibold text-ink">{title}</h3>
  <p class="mt-2 text-sm text-ink-muted">{description}</p>
</div>
