---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const canonical = project.data.article_url || undefined;
---

<ContentLayout
  title={project.data.title}
  description={project.data.description}
  date={project.data.date}
  tags={project.data.tags}
  canonical={canonical}
>
  {project.data.status === 'coming-soon' ? (
    <p>Details coming soon.</p>
  ) : (
    <Content />
  )}

  {(project.data.source_url || project.data.demo_url) && (
    <section class="mt-10 border-t border-border pt-6">
      <h2>Links</h2>
      <ul>
        {project.data.source_url && (
          <li>
            <a href={project.data.source_url} rel="noopener noreferrer" target="_blank">Source</a>
          </li>
        )}
        {project.data.demo_url ? (
          <li>
            <a href={project.data.demo_url} rel="noopener noreferrer" target="_blank">Demo</a>
          </li>
        ) : project.data.source_url ? (
          <li>Demo coming soon. The source is available now; an interactive demo will be added later.</li>
        ) : null}
      </ul>
    </section>
  )}

  <p class="mt-10 text-sm text-ink-subtle">
    <a href={`${import.meta.env.BASE_URL}projects/`}>← Back to projects</a>
    {' · '}
    {site.name}
  </p>
</ContentLayout>
