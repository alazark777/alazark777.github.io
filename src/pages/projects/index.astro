---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import { getPublishedProjects } from '../../lib/content';

const projects = await getPublishedProjects();
const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
const hasRealProjects = projects.some((p) => p.data.status !== 'coming-soon');
---

<BaseLayout title="Projects" description="AI engineering and data science projects.">
  <section class="container-page py-12 sm:py-16">
    <header class="mb-8 max-w-2xl">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Projects</h1>
      <p class="mt-3 text-ink-muted">
        Case studies and applied systems work. Filter by tag or search by title.
      </p>
    </header>

    {projects.length > 0 && (
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <label class="block max-w-md flex-1 text-sm">
          <span class="mb-1.5 block font-medium text-ink">Search</span>
          <input
            type="search"
            id="project-search"
            placeholder="Search projects…"
            class="w-full rounded-md border border-border bg-surface-raised px-3 py-2 text-ink placeholder:text-ink-subtle"
          />
        </label>

        {tags.length > 0 && (
          <fieldset class="min-w-0">
            <legend class="mb-1.5 text-sm font-medium text-ink">Tags</legend>
            <div class="flex flex-wrap gap-2" id="project-tags" role="group" aria-label="Filter by tag">
              <button
                type="button"
                data-tag=""
                class="tag-filter is-active rounded-md border border-accent bg-accent-soft px-2.5 py-1 text-xs font-medium text-accent"
              >
                All
              </button>
              {tags.map((tag) => (
                <button
                  type="button"
                  data-tag={tag.toLowerCase()}
                  class="tag-filter rounded-md border border-border bg-surface-raised px-2.5 py-1 text-xs font-medium text-ink-muted hover:border-border-strong"
                >
                  {tag}
                </button>
              ))}
            </div>
          </fieldset>
        )}
      </div>
    )}

    {projects.length > 0 ? (
      <div id="project-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <ComingSoon title="Coming soon" description="A detailed AI engineering case study will appear here." />
        <ComingSoon title="Coming soon" description="A detailed AI engineering case study will appear here." />
        <ComingSoon title="Coming soon" description="A detailed AI engineering case study will appear here." />
      </div>
    )}

    {!hasRealProjects && projects.length > 0 && (
      <p class="mt-8 text-sm text-ink-subtle">
        Placeholder cards are layout examples only — not completed work.
      </p>
    )}

    <p id="project-empty" class="mt-8 hidden text-sm text-ink-muted" hidden>
      No projects match your filters.
    </p>
  </section>
</BaseLayout>

<script>
  const search = document.getElementById('project-search') as HTMLInputElement | null;
  const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tag-filter');
  const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');
  const empty = document.getElementById('project-empty');
  let activeTag = '';

  function applyFilters() {
    const query = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const title = card.dataset.title ?? '';
      const description = card.dataset.description ?? '';
      const tags = card.dataset.tags ?? '';
      const matchesQuery =
        !query || title.includes(query) || description.includes(query) || tags.includes(query);
      const matchesTag = !activeTag || tags.split('|').includes(activeTag);
      const show = matchesQuery && matchesTag;
      card.hidden = !show;
      if (show) visible += 1;
    });

    if (empty) {
      empty.hidden = visible !== 0;
      empty.classList.toggle('hidden', visible !== 0);
    }
  }

  search?.addEventListener('input', applyFilters);

  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeTag = button.dataset.tag ?? '';
      tagButtons.forEach((btn) => {
        const on = btn === button;
        btn.classList.toggle('is-active', on);
        btn.classList.toggle('border-accent', on);
        btn.classList.toggle('bg-accent-soft', on);
        btn.classList.toggle('text-accent', on);
        btn.classList.toggle('border-border', !on);
        btn.classList.toggle('bg-surface-raised', !on);
        btn.classList.toggle('text-ink-muted', !on);
      });
      applyFilters();
    });
  });
</script>
