---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---

<BaseLayout title="About" description={`About ${site.name} — AI and data science portfolio.`}>
  <section class="container-page py-12 sm:py-16">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">About</h1>
    <div class="mt-8 max-w-2xl space-y-4 text-ink-muted">
      <p>
        This portfolio collects applied AI and data science work — projects, technical writing,
        and notes on systems that use machine learning, generative AI, RAG, and agents.
      </p>
      <p>
        Personal bio details will be added here. Until then, this page intentionally avoids
        invented employers, degrees, or claims.
      </p>
      {(site.github || site.linkedin || site.email) && (
        <div class="pt-4">
          <h2 class="text-lg font-semibold text-ink">Connect</h2>
          <ul class="mt-3 space-y-2">
            {site.github && (
              <li>
                <a href={site.github} rel="noopener noreferrer" target="_blank">GitHub</a>
              </li>
            )}
            {site.linkedin && (
              <li>
                <a href={site.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
              </li>
            )}
            {site.email && (
              <li>
                <a href={`mailto:${site.email}`}>Email</a>
              </li>
            )}
          </ul>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
