---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingCard from '../components/WritingCard.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { site } from '../site.config';
import { getFeaturedProjects, getPublishedWriting } from '../lib/content';

const featuredProjects = await getFeaturedProjects(3);
const recentWriting = (await getPublishedWriting()).slice(0, 3);
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="border-b border-border bg-surface-raised">
    <div class="container-page py-16 sm:py-24">
      <p class="text-sm font-medium uppercase tracking-wide text-accent">{site.headline}</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        {site.name}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-muted">
        {site.tagline}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`${base}projects/`}
          class="inline-flex rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-white no-underline hover:opacity-90 hover:no-underline"
        >
          View projects
        </a>
        <a
          href={`${base}writing/`}
          class="inline-flex rounded-md border border-border bg-surface-raised px-4 py-2.5 text-sm font-medium text-ink no-underline hover:border-border-strong hover:no-underline"
        >
          Read writing
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-14" aria-labelledby="featured-projects">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2 id="featured-projects" class="text-2xl font-semibold tracking-tight">Featured Projects</h2>
        <p class="mt-1 text-sm text-ink-muted">Selected case studies and applied AI work.</p>
      </div>
      <a href={`${base}projects/`} class="text-sm no-underline hover:underline">All projects</a>
    </div>

    {featuredProjects.length > 0 ? (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <ComingSoon title="Project coming soon" description="A detailed AI engineering case study will appear here." />
        <ComingSoon title="Project coming soon" description="A detailed AI engineering case study will appear here." />
        <ComingSoon title="Project coming soon" description="A detailed AI engineering case study will appear here." />
      </div>
    )}
  </section>

  <section class="border-y border-border bg-surface-raised">
    <div class="container-page py-14" aria-labelledby="recent-writing">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <h2 id="recent-writing" class="text-2xl font-semibold tracking-tight">Recent Writing</h2>
          <p class="mt-1 text-sm text-ink-muted">Technical notes, experiments, and practical AI engineering articles.</p>
        </div>
        <a href={`${base}writing/`} class="text-sm no-underline hover:underline">All writing</a>
      </div>

      {recentWriting.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {recentWriting.map((entry) => (
            <WritingCard entry={entry} />
          ))}
        </div>
      ) : (
        <ComingSoon
          title="Writing coming soon"
          description="Technical notes, experiments, and practical AI engineering articles will appear here."
        />
      )}
    </div>
  </section>

  <section class="container-page py-14" aria-labelledby="focus-areas">
    <h2 id="focus-areas" class="text-2xl font-semibold tracking-tight">Focus Areas</h2>
    <p class="mt-1 text-sm text-ink-muted">Site taxonomy labels for browsing related work.</p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {site.focusAreas.map((area) => (
        <li class="rounded-md border border-border bg-surface-raised px-3 py-1.5 text-sm text-ink-muted">
          {area}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
